# Copia este fichero como .env y rellena los valores.
# El .env NUNCA se sube al repositorio.

# --- Django ---
# Genera una clave con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=cambia-esto
# True solo en desarrollo. En el servidor: False.
DJANGO_DEBUG=True
# Nombres con los que se accede a la app, separados por comas.
# En el servidor: su nombre y su IP (p. ej. localhost,127.0.0.1,SRV-APPS,10.0.0.25).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Origen del servidor de Vite en desarrollo (necesario para que el CSRF acepte peticiones desde React)
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173

# --- Servidor (run.py) ---
# 0.0.0.0 = accesible desde otros equipos de la red; 127.0.0.1 = solo este equipo
APP_HOST=0.0.0.0
APP_PORT=8002
# Peticiones atendidas a la vez. 8 sobra para una aplicación interna.
APP_THREADS=8

# --- Base de datos (PostgreSQL 18 nativo) ---
# Rol y base de datos creados con database/01_crear_bd.sql.
# DB_PASSWORD es la contraseña que pasaste a ese script con -v password=...
DB_NAME=control_formacion
DB_USER=control_formacion
DB_PASSWORD=cambia-esto
DB_HOST=localhost
DB_PORT=5432