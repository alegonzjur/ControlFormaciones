# Copia este fichero como .env y rellena los valores.
# El .env NUNCA se sube al repositorio.

# --- Django ---
# Genera una clave con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=cambio
# True solo en desarrollo. En el servidor: False.
DJANGO_DEBUG=True
# Nombres con los que se accede a la app. En el servidor, añade su nombre o IP.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Origen del servidor de Vite en desarrollo (necesario para que el CSRF acepte peticiones desde React)
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173

# --- Base de datos (PostgreSQL 18 nativo) ---
# Rol y base de datos creados con database/01_crear_bd.sql.
# DB_PASSWORD es la contraseña que pasaste a ese script con -v password=...
DB_NAME=control_formacion
DB_USER=control_formacion
DB_PASSWORD=cambia-esto
DB_HOST=localhost
DB_PORT=5432