# Copia este fichero como .env y rellena los valores.
# El .env NUNCA se sube al repositorio.

# --- Django ---
# Genera una clave con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=cambia-esto
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Origen del servidor de Vite en desarrollo (necesario para que el CSRF acepte peticiones desde React)
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173

# --- Base de datos ---
# En desarrollo: el contenedor de docker-compose.
# En producción: el PostgreSQL 18 nativo del servidor.
DB_NAME=control_formacion
DB_USER=control_formacion
DB_PASSWORD=cambia-esto
DB_HOST=localhost
# Desarrollo: 5433 (el 5432 lo usa el contenedor del otro proyecto).
# Producción: el puerto real del PostgreSQL del servidor (normalmente 5432).
DB_PORT=5433